# ---------------------------------------------------------------------------
# Banco de dados
# No EasyPanel, use o hostname interno do serviço Postgres (ex.: fmpcustos_db).
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://fmpcustos:senha@localhost:5432/fmpcustos?schema=public"

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
NODE_ENV="development"
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Autenticação — OBRIGATÓRIO
# Assina o cookie de sessão. Sem isto ninguém consegue entrar.
# Gere com: openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Primeiro administrador — lido apenas pelo seed, e só se ainda não houver
# nenhum administrador no banco. ADMIN_SENHA é opcional: sem ela, uma senha
# temporária é sorteada e impressa uma única vez no log do seed.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=""
ADMIN_NOME=""
# Opcional. Se preenchida, precisa ter ao menos 10 caracteres, com letras e
# números — a mesma regra que a aplicação exige de qualquer usuário.
ADMIN_SENHA=""
# Só para redefinir a senha de um administrador que JÁ existe. Sem isto, o seed
# nunca mexe numa conta existente.
ADMIN_RESET_SENHA=""

# ---------------------------------------------------------------------------
# SSO Microsoft Entra ID — fase futura. Deixe vazio.
# ---------------------------------------------------------------------------
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# ---------------------------------------------------------------------------
# Envio de e-mail — resumo semanal de custos
# Sem estas variáveis os alertas continuam aparecendo na tela, mas nenhum e-mail
# sai. A tela Administração › Notificações mostra o estado e testa a conexão.
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORTA="587"
SMTP_USUARIO=""
SMTP_SENHA=""
# Opcional. Sem isto, o remetente é "Custos FMP <SMTP_USUARIO>".
SMTP_REMETENTE=""
# Opcional. A porta decide sozinha (465 = TLS, 587 = STARTTLS); só preencha se o
# servidor fugir da convenção.
SMTP_SEGURO=""

# ---------------------------------------------------------------------------
# Rotinas agendadas — OBRIGATÓRIO para que o cron consiga chamar
# Sem este token, /api/rotinas/* recusa TODAS as chamadas, inclusive as sem
# token. Gere com: openssl rand -base64 32
#
#   POST /api/rotinas/alertas   diária, de manhã cedo
#   POST /api/rotinas/resumo    semanal, depois da varredura
#   Authorization: Bearer $ROTINAS_TOKEN
# ---------------------------------------------------------------------------
ROTINAS_TOKEN=""
